<h1>Žádosti o adopci</h1> 
 
<% requests.forEach(request => { %> 
 
<div> 
 
  <h3><%= request.animal.name %></h3> 
 
  <p>Žadatel: <%= request.applicantName %></p> 
  <p>Email: <%= request.email %></p> 
  <p>Zpráva: <%= request.message %></p> 
  <p>Stav: <%= request.status %></p> 
 
  <form action="/adoptions/<%= request._id %>/approve" method="POST"> 
    <button>Schválit</button> 
  </form> 
 
  <form action="/adoptions/<%= request._id %>/reject" method="POST"> 
    <button>Zamítnout</button> 
  </form> 
 
</div> 
 
<hr> 
 
<% }) %>