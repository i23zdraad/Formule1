<h1><%= animal.name %></h1> 
<p>Druh: <%= animal.species %></p> 
<p>Věk: <%= animal.age %></p> 
<p><%= animal.description %></p> 
<% if (animal.image) { %>
    <img src="/uploads/<%= animal.image %>" width="300">
   <% } %>
<% if (user) { %>
    <a href="/animals/<%= animal._id %>/edit">Upravit</a>
    <form action="/animals/<%= animal._id %>?_method=DELETE" method="POST">
    <button>Smazat</button>
    </form>
   <% } %>
<p><a href="/animals">Zpět</a></p>
<h2>Žádost o adopci</h2> 
<form action="/adoptions/<%= animal._id %>" method="POST"> 
<input type="text" name="applicantName" placeholder="Jméno" required> 
<br><br> 
<input type="email" name="email" placeholder="Email" required> 
<br><br> 
<textarea name="message" placeholder="Proč chcete adoptovat?" 
required></textarea> 
<br><br> 
<button type="submit">Odeslat žádost</button> 
</form>