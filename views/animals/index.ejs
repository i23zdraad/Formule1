
<% if (user) { %>
    <form action="/logout" method="POST">
    <button>Odhlásit se</button>
    </form>
   <% } else { %>
    <a href="/login">Login</a>
   <% } %>
   <% if (user) { %> 
    <a href="/adoptions">Žádosti o adopci</a> 
    <% } %> 
    <% if (user && user.role === "admin") { %> 
        <a href="/admin/users">Správa uživatelů</a> 
        <% } %>
<h1>Seznam zvířat</h1> 
<% animals.forEach(animal => { %> 
<div> 
<h2> 
<a href="/animals/<%= animal._id %>"> 
<%= animal.name %> 
</a> 
</h2> 
<p>Druh: <%= animal.species %></p> 
<p>Věk: <%= animal.age %></p>
<% if (animal.image) { %>
    <img src="/uploads/<%= animal.image %>" width="200">
   <% } %> 
</div> 
<hr> 
<% }) %> 