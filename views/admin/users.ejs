<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <title>Správa uživatelů – F1 Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/loader.js" defer></script>
</head>
<body>
  <div id="loader">
    <div class="spinner"></div>
    <div class="loader-text">F1 Tracker</div>
  </div>

  <%- include("../partials/navbar") %>

  <div class="container">
    <h1>Správa uživatelů</h1>

    <% users.forEach(oneUser => { %>
      <div class="card" style="padding:1.5rem; margin-bottom:1rem;">
        <p style="font-size:1.1rem;">
          <strong><%= oneUser.username %></strong>
          <span style="color:#e10600; font-weight:600;">– role: <%= oneUser.role %></span>
        </p>

        <% if (oneUser.role !== "admin" || oneUser._id.toString() === user.id) { %>
          <form action="/admin/users/<%= oneUser._id %>/role" method="POST" style="display:flex; gap:1rem; align-items:center; margin-top:0.5rem;">
            <select name="role" style="padding:0.5rem; background:#0f0f0f; color:#fff; border:1px solid #333; border-radius:4px;">
              <option value="user" <%= oneUser.role === "user" ? "selected" : "" %>>user</option>
              <option value="spravce" <%= oneUser.role === "spravce" ? "selected" : "" %>>spravce</option>
              <option value="admin" <%= oneUser.role === "admin" ? "selected" : "" %>>admin</option>
            </select>
            <button type="submit" class="btn">Změnit roli</button>
          </form>
        <% } else { %>
          <p style="color:#666; margin-top:0.5rem;">Admin nemůže měnit roli jinému adminovi.</p>
        <% } %>
      </div>
    <% }) %>

    <p style="margin-top:2rem;"><a href="/circuits">← Zpět na okruhy</a></p>
  </div>
</body>
</html>